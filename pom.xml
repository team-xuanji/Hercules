<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>team.magic-flute</groupId>
  <artifactId>Hercules</artifactId>
  <version>Nemean-Lion-1.0</version>
  <packaging>pom</packaging>

  <name>Hercules</name>
  <url>https://maven.apache.org</url>
    <modules>
      <module>Hercules-service</module>
      <module>Hercules-executor</module>
      <module>Hercules-manager</module>
      <module>Hercules-executor-plugin</module>
      <module>Hercules-twelve-labors</module>
      <module>Hercules-common</module>
    </modules>

  <properties>
      <hercules.version>Nemean-Lion-1.0</hercules.version>
      <maven.compiler.source>17</maven.compiler.source>
      <maven.compiler.target>17</maven.compiler.target>
      <maven.compiler.release>17</maven.compiler.release>
      <uuid-creator.version>6.1.1</uuid-creator.version>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <commons-collections.version>4.5.0</commons-collections.version>
      <aliyun-sdk-oss.version>3.13.2</aliyun-sdk-oss.version>
      <aws.version>2.20.0</aws.version>
      <auto-service.version>1.1.1</auto-service.version>
      <commons-io.version>2.20.0</commons-io.version>
      <fory.version>0.14.1</fory.version>
      <aircompressor.version>2.0.2</aircompressor.version>
      <mysql-connector-java.version>8.0.33</mysql-connector-java.version>
      <bouncycastle.version>1.83</bouncycastle.version>
      <feign-bom.version>13.6</feign-bom.version>
      <!-- spring -->
      <spring-boot.version>4.1.1</spring-boot.version>
      <jackson.version>3.1.7</jackson.version>
      <!-- Jackson 2 databind pinned for feign-jackson co-existence. -->
      <jackson2-databind.version>2.21.2</jackson2-databind.version>
      <!-- OkHttp: dropped from Boot 4 dependency management; pinned for
           feign-okhttp + direct usage (executor / twelve-labors). -->
      <okhttp.version>4.12.0</okhttp.version>

      <!-- DB -->
      <mybatis-plus-boot-starter.version>3.5.17</mybatis-plus-boot-starter.version>
      <mybatis-plus-generator.version>3.5.17</mybatis-plus-generator.version>
      <duckdb.version>1.5.6.0</duckdb.version><!--For operating systems that only support GCC4, you need to compile a version of DuckDB (version ≤ 1.2.2.0) that supports GCC4 yourself.-->

      <!-- Build plugins -->
      <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
      <git-commit-id-plugin.version>9.0.1</git-commit-id-plugin.version>
      <spotless-plugin.version>2.45.0</spotless-plugin.version>
      <google-java-format.version>1.28.0</google-java-format.version>
      <maven-shade-plugin.version>3.6.1</maven-shade-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws.version}</version>
        </dependency>

        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>aircompressor</artifactId>
            <version>${aircompressor.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.fory</groupId>
            <artifactId>fory-core</artifactId>
            <version>${fory.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector-java.version}</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

      <dependency>
        <groupId>com.google.auto.service</groupId>
        <artifactId>auto-service</artifactId>
        <version>${auto-service.version}</version>
<!--        <scope>provided</scope>-->
      </dependency>

      <!-- Spring Boot 4.x BOM (Spring Cloud removed: no Spring Cloud code/annotations in repo; Feign uses io.github.openfeign). -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Explicit Feign BOM (still used as a pin because Spring Boot 4 does not curate io.github.openfeign groupId). -->
      <dependency>
        <groupId>io.github.openfeign</groupId>
        <artifactId>feign-bom</artifactId>
        <version>${feign-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Jackson 3 BOM -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- mybatis-spring-starter -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-bom</artifactId>
            <version>3.5.17</version>
            <type>pom</type>
            <scope>import</scope>
        </dependency>

      <!-- mybatis-spring-boot4-starter (Jakarta namespace; replaces mybatis-plus-boot-starter in Boot 4). -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        <version>${mybatis-plus-boot-starter.version}</version>
      </dependency>
      <!-- mybatis-plus-jsqlparser (JDK11+ replacement for mybatis-plus-jsqlparser-4.9 in the Boot4 series). -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus-boot-starter.version}</version>
      </dependency>
      <!-- mybatis-code-generator -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-generator</artifactId>
        <version>${mybatis-plus-generator.version}</version>
      </dependency>

      <dependency>
        <groupId>org.duckdb</groupId>
        <artifactId>duckdb_jdbc</artifactId>
        <version>${duckdb.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.f4b6a3</groupId>
        <artifactId>uuid-creator</artifactId>
        <version>${uuid-creator.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-collections4</artifactId>
        <version>${commons-collections.version}</version>
      </dependency>

      <dependency>
        <groupId>com.aliyun.oss</groupId>
        <artifactId>aliyun-sdk-oss</artifactId>
        <version>${aliyun-sdk-oss.version}</version>
      </dependency>

      <!-- Jackson 2 databind + annotations — kept for feign-jackson's co-existing ObjectMapper
           (FeignConfig/FeignErrorDecoder). tools.jackson.databind.ext.javatime covers JSR-310; no
           separate tools.jackson.datatype module needed. -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson2-databind.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <!-- Annotations release independently of databind: 2.21.2 databind pairs
             with annotations 2.21 (latest 2.x annotations on Central). -->
        <version>2.21</version>
      </dependency>
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp</artifactId>
        <version>${okhttp.version}</version>
      </dependency>
      <!-- Jackson 2 java.time module for the Feign-side ObjectMapper
           (executor / twelve-labors FeignConfig). -->
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
        <version>${jackson2-databind.version}</version>
      </dependency>

      <!-- JUnit 5 + JUnit Platform baseline fix for Hercules-common. -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>5.11.4</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Surefire: run pure unit tests by default, exclude anything tagged
          "integration" (JUnit 5 @Tag) and the legacy JUnit 3 external-resource
          tests (DuckDB/OSS/network) which cannot be tagged. Integration suites
          are re-enabled with -DexcludedGroups= or by dropping the excludes.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
          <configuration>
            <!-- Legacy JUnit 3 external-resource tests (DuckDB/OSS/network) cannot
                 be tagged, so exclude them by pattern everywhere. The JUnit 5
                 @Tag("integration") exclusion is configured per-module in the
                 modules that actually carry JUnit Platform (manager/executor). -->
            <excludes>
              <exclude>**/AppTest.java</exclude>
              <exclude>**/AppTest01.java</exclude>
              <exclude>**/PluginTest.java</exclude>
              <exclude>**/ExportPluginTest.java</exclude>
            </excludes>
          </configuration>
        </plugin>

        <!-- maven-compiler-plugin centralized to release=17 for all modules. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>17</release>
            <encoding>UTF-8</encoding>
          </configuration>
        </plugin>

        <!-- Spotless: in module poms that opt in, this enforces AOSP-style
             formatting on the verify phase. Kept here only to pin version + style;
             executions live per module so unrelated modules don't run spotless. -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-plugin.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>AOSP</style>
              </googleJavaFormat>
            </java>
          </configuration>
        </plugin>

        <!-- git-commit-id: new artifactId io.github.git-commit-id (relocated from pl.project13.maven). -->
        <plugin>
          <groupId>io.github.git-commit-id</groupId>
          <artifactId>git-commit-id-maven-plugin</artifactId>
          <version>${git-commit-id-plugin.version}</version>
          <configuration>
            <failOnNoGitDirectory>false</failOnNoGitDirectory>
            <generateGitPropertiesFile>true</generateGitPropertiesFile>
            <dateFormat>yyyyMMddHHmmss</dateFormat>
            <replacementProperties>
              <replacementProperty>
                <property>git.branch</property>
                <token>/</token>
                <value>-</value>
              </replacementProperty>
            </replacementProperties>
          </configuration>
          <executions>
            <execution>
              <id>get-the-git-infos</id>
              <goals>
                <goal>revision</goal>
              </goals>
              <phase>initialize</phase>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
